      "hls_manifest": "hls_l8_conditions_2019_2025_lc08/hls_condition_manifest.csv",
      "splits": ["train", "val", "test"],
      "hls_sample_key": ["sequence_id"],
      "lst_hr_sample_key": ["sequence_id", "available_month"],
      "hls_array_key": "hls_reflectance_i16",
      "hls_valid_key": "hls_valid",
      "hls_fmask_key": "hls_fmask",
      "hls_scale": 0.0001,
      "hls_nodata": -32768,
      "lst_hr_array_key": "hr_lst",
      "lst_hr_valid_key": "hr_valid",
      "lst_nodata": -32768,
      "lst_physical_unit": null,
      "lst_baseline_statistics_space": "raw_int16_as_float_until_physical_decode_confirmed",
      "availability_rule": "manifest_available_months_AND_nonempty_hr_valid",
      "require_complete_twelve_months": false,
      "lst_lr_in_current_baseline": false
