{
  "protocol_id": "eo-independent-reconstruction-v1",
  "status": "defined_not_materialized",
  "training_scope": "independent_datasets",
  "shared_processing_policy": {
    "modalities": ["hls", "lst_hr"],
    "shape": {"hls": [6, 256, 256], "lst_hr": [1, 256, 256]},
    "dtype": "float32",
    "hls_band_order": ["Blue", "Green", "Red", "NIR", "SWIR1", "SWIR2"],
    "hls_fmask_fill": 255,
    "hls_bad_fmask_bits": 14,
    "hls_mask_rule": "source_valid AND all_bands_not_fill AND fmask!=255 AND (fmask&14)==0",
    "lst_mask_rule": "source_valid_if_present AND raw_not_source_fill",
    "remove_zero_as_nodata": false,
    "extra_snow_water_aerosol_exclusion": false,
    "normalization": {
      "method": "fixed_zscore",
      "fit_split": "train",
      "parameter_scope": ["dataset_id", "modality", "split_hash"],
      "hls": "per_band",
      "lst_hr": "one_channel_global",
      "weighting": "equal_training_samples_and_equal_valid_pixels_within_each_sample",
      "per_image_fitting": false,
      "clip": false,
      "invalid_fill_after_normalization": 0.0,
      "train_only": true,
      "physical_unit_required_for_physical_metrics": true
    },
    "augmentation": {"geometric": false, "synthetic_noise": false},
    "sampling": "uniform_shuffle_over_eligible_modality_samples",
    "hls_repeat_per_lst_month_for_independent_training": false,
    "model_specific_resizing_or_normalization": false,
    "prithvi_time_dimension": "length_one_layout_only",
    "loss_reduction": "mean_of_per_sample_valid_element_means",
    "all_invalid_sample": "exclude_for_that_modality_and_log",
    "expose_provenance_to_model_automatically": false
  },
  "datasets": {
    "prithvi": {
      "root": "prithvi_data",
      "index_source": "actual_file_inventory",
      "sample_key": ["source_split", "tile", "obs_idx", "row", "col"],
      "splits": ["train", "val"],
      "hls_array": "bands.npy",
      "hls_fmask": "fmask.npy",
      "hls_scale": 0.0001,
      "hls_fill_candidates": [-9999, -32767, -32768],
      "lst_hr_array": "lst.npy",
      "lst_observed_fill": -32767,
      "lst_recorded_scale_divisor": 100,
      "lst_physical_unit": null,
      "lst_baseline_statistics_space": "raw_int16_as_float_until_physical_decode_confirmed"
    },
    "lstsr_tb": {
      "upload_root": "lstsr_tb_final_upload_20260721",
